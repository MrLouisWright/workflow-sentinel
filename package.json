{
  "name": "workflow-sentinel",
  "version": "1.1.1",
  "description": "Harden GitHub Actions: flags unpinned actions, broad or missing permissions, pull_request_target pwn requests, script injection, leaked secrets, persisted credentials, self-hosted PR runners, curl|bash, deprecated commands and undigested images, with a fix for each. --fix pins SHAs. Text, JSON, SARIF, Markdown; GitHub Action included.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "workflow-sentinel": "bin/workflow-sentinel.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "keywords": [
    "github-actions",
    "security",
    "workflow",
    "ci",
    "supply-chain-security",
    "pinning",
    "sha-pinning",
    "pull-request-target",
    "script-injection",
    "sarif",
    "cli",
    "github-action",
    "devsecops",
    "linter",
    "hardening"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/workflow-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/workflow-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/workflow-sentinel/"
}
